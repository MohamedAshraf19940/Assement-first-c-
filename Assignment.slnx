  #region Question 4: Class-level vs Method-level Scope
  // ══════════════════════════════════════════════════════════════════════
  // QUESTION 4: CLASS-LEVEL VS METHOD-LEVEL SCOPE
  // ══════════════════════════════════════════════════════════════════════
  //
  // Q: Explain the difference between class-level scope and method-level 
  //    scope with examples.
  //
  // ══════════════════════════════════════════════════════════════════════
Class-level scope
المتغير متاح لكل الميثودات داخل الكلاس
بيعيش طول عمر الكائن (object)
مثال:private string name;
-----------------------------------------------------------------------------
Method-level scope
المتغير متاح فقط داخل الميثود اللي اتعرّف فيه
بيعيش طول تنفيذ الميثود فقط
مثال: int age = 20;
------------------------------------------------------------------


